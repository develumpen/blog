<% content_for :title, t(".title") %>

<p><%= link_to "Nueva página", new_admin_page_path %></p>

<table id="entries" class="table">
  <thead>
    <tr>
      <th>Published at</th>
      <th>Title</th>
      <th>Status</th>
      <th>Comments</th>
    </tr>
  </thead>
  <tbody>
    <% @entries.each do |entry| %>
      <tr>
        <td>
          <% if entry.published_at %>
            <%= l entry.published_at, format: :short %>
          <% else %>
            -
          <% end %>
        </td>
        <td><%= link_to entry.title, edit_admin_page_path(entry) %></td>
        <td><%= entry.status %></td>
        <td class="text-center"><%= entry.comments.count %></td>
      </tr>
    <% end %>
  </tbody>
</table>
