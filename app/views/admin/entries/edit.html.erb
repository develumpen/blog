<% content_for :title, t(".title") %>

<h1><%= content_for :title %></h1>

<%= render "form", entry: @entry, url: admin_entry_path(@entry) %>

<br />

<%= button_to "Eliminar Entrada", admin_entry_path(@entry), method: :delete, data: { turbo_confirm: "Are you sure?" } %>

<br />

<div>
  <%= link_to "Ver entrada", entry_slug_path(@entry.slug) %>
</div>
